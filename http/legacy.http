#
#   01    => Authentication
#


### 01.01 -> SignIn
# @name login

POST {{base-url}}/SignIn.php
Content-Type: application/x-www-form-urlencoded; charset=UTF-8
User-Agent: {{user-agent}}

_format={{format}}
&userEmail={{user-name}}
&userPassword={{user-pass}}

### --> Get the token
@access-token = {{login.response.body.values.token}}


### 01.02 -> SignInfo

POST {{base-url}}/SignInfo.php
Content-Type: application/x-www-form-urlencoded; charset=UTF-8
Authorization: Bearer {{access-token}}

_format=json


### 01.03 -> SignOut

POST {{base-url}}/SignOut.php
Content-Type: application/x-www-form-urlencoded; charset=UTF-8
Authorization: Bearer {{access-token}}

_format=json


### 01.04 -> SignUp

POST {{base-url}}/SignUp.php
Content-Type: application/x-www-form-urlencoded; charset=UTF-8
User-Agent: {{user-agent}}

_format={{format}}
&userEmail=test@example.com
&userPassword=password123
&firstName=John
&lastName=Doe
&birthday=1990-01-01
&country=US
&state=CA
&city=Los Angeles


