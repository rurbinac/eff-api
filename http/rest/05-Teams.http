@base-url = https://eff-api-150703383580.us-central1.run.app
@user-agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
@format = json
@user-name = nigel@bowmantx.com
@user-pass = PASSWORD_9
@user-id = 9
@real-competition-id = 21
@real-competition-match-day = 38
@league-id = 63
@division-id = 130
@team-id = 1187
@match-team-id = 16971


### 01. SignIn
# @name login

POST {{base-url}}/api/v1/auth/sign_in
Content-Type: application/json
User-Agent: {{user-agent}}

{
  "userEmail": "{{user-name}}",
  "userPassword": "{{user-pass}}"
}


### --> Get the token
@access-token = {{login.response.body.token}}


### 02. Teams - all by {{league-id}}

GET {{base-url}}/api/v1/teams?leagueID={{league-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}


### 03. Teams - all by {{division-id}}

GET {{base-url}}/api/v1/teams?divisionID={{division-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}



### 04. Teams - WaiverMembersDetail - {{team-id}}

GET {{base-url}}/api/v1/teams/waiver_members_detail?teamID={{team-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}

### 05. Teams - WishListDetail - {{team-id}}

GET {{base-url}}/api/v1/teams/wish_list_detail?teamID={{team-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}


### 06. Teams - GetCurrentMembers - {{team-id}}

GET {{base-url}}/api/v1/teams/current_members?teamID={{team-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}


### 07. Teams - GetRealMembersRanking - {{team-id}}

GET {{base-url}}/api/v1/teams/real_members_ranking?teamID={{team-id}}
Content-Type: application/json
User-Agent: {{user-agent}}
Authorization: Bearer {{access-token}}
