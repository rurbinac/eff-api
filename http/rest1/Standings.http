@base-url = https://eff-api-150703383580.us-central1.run.app
@user-name = nigel@bowmantx.com
@user-pass = PASSWORD_9
@division-id = 130
@real-competition-id = 21


### SignIn (Token)
# @name signin

POST {{base-url}}/api/auth/signin
Content-Type: application/json

{
  "userEmail": "{{user-name}}",
  "userPassword": "{{user-pass}}"
}


### Extract token
@access-token = {{signin.response.body.token}}


### Team Standings ReadList

POST {{base-url}}/api/teamstandings/readlist
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "divisionID": {{division-id}}
}


### Real Standings ReadList

POST {{base-url}}/api/realstandings/readlist
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "realCompetitionID": {{real-competition-id}},
  "realCompetitionSeasonID": 2025
}


### Real Team Standings ReadList

POST {{base-url}}/api/realteamstandings/readlist
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "realCompetitionID": {{real-competition-id}},
  "realCompetitionSeasonID": 2025
}
