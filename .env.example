# --- Production (Cloud Run) ---
# Cloud SQL instance connection name: project-id:region:instance-name
CLOUD_SQL_INSTANCE=sublime-scion-499902-m5:us-central1:eff-db

DB_NAME=eff
DB_USER=appuser
DB_PASSWORD=changeme

APP_ENV=production

# --- Admin endpoints (backup/restore) ---
# Set a strong random token; pass as Authorization: Bearer <token>
ADMIN_TOKEN=

# --- Pusher ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# --- Local development (Docker) ---
# Copy this file to .env and set the values below.
# DB_HOST is set automatically by docker-compose; leave blank for Cloud Run.
# DB_HOST=db

# Set to any non-empty value to allow http://localhost:5173 in CORS (admin Vue dev server)
ADMIN_DEV_CORS=
